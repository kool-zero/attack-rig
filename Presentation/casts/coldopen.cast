[159.54058, "o", "\u001b[3S\u001b[2A==== install-linux-tools summary ====\u001b[K\r\ninstalled:       bat(->batcat) just starship claude codex\u001b[K\r\n\u001b[K\u001b[?25l\u001b[?12l\u001b[?25h"]
[159.544133, "o", "\u001b[6S\u001b[6A(apt: zsh tmux git curl ca-certificates fzf ripgrep bat eza jq zoxide direnv unzip)\u001b[K\r\n(npm into ~/.local: @anthropic-ai/claude-code @openai/codex )\u001b[K\r\n(upstream binaries come from .chezmoiexternal.toml, not this script)\u001b[K\r\nOpen a new shell or run 'exec zsh' so ~/.local/bin and the new tools are on PATH.\u001b[K\r\n\u001b[K\u001b[?25l\u001b[?12l\u001b[?25h"]
[159.562229, "o", "\u001b[2S\u001b[2A==> install-ghostty: no ~/.chezmoi_only_copy_files -> provisioning via the carried playbook\u001b[K\r\n\u001b[K\u001b[?25l\u001b[?12l\u001b[?25h"]
