# ~/.config/bat/config: bat defaults for the rig. The Catppuccin Mocha theme it points
# at is installed by .chezmoiscripts/run_once_after_theme-bat-catppuccin.sh (fetches the
# .tmTheme into ~/.config/bat/themes and runs `bat cache --build`). Until that runs bat
# just falls back to a built-in theme, so this file is always safe to ship.
--theme="Catppuccin Mocha"

# Show line numbers, git changes, and the file header; keep it readable, not noisy.
--style="numbers,changes,header"

# Wrap long lines instead of truncating.
--wrap=auto
