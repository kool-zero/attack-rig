# ~/.tmux.conf (chezmoi template). Capture/grab bindings, sane defaults, TPM plugins at the bottom.

{{- if lookPath "zsh" }}
# use zsh if it's on the box
set -g default-shell "{{ lookPath "zsh" }}"
{{- end }}
set -g default-terminal "xterm-256color"
set -ga terminal-overrides ",*256col*:Tc"
set-environment -g COLORTERM "truecolor"
# passthrough + extended keys for apps running inside tmux (Claude Code, etc.)
set -g allow-passthrough on
set -s extended-keys on
set -as terminal-features 'xterm*:extkeys'

# click to select, drag to resize, wheel to scroll
set -g mouse on

# scrollback cap; how far back prefix H can reach
set -g history-limit 200000

# --- splits & pane resize ------------------------------------------------------------
# | and - split, keeping the pane's cwd; drop the default "/% keys
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %
# repeatable resize: hold prefix, tap Ctrl-h/j/k/l
bind -r C-h resize-pane -L 5
bind -r C-j resize-pane -D 5
bind -r C-k resize-pane -U 5
bind -r C-l resize-pane -R 5
# reload config
bind r source-file ~/.tmux.conf \; display-message "tmux.conf reloaded"

# --- capture: keep a record of a pane -----------------------------------------------
# prefix C: toggle live logging of this pane to ~/.tmux-logs/
bind C pipe-pane -o 'mkdir -p ~/.tmux-logs; cat >> ~/.tmux-logs/#{session_name}-#{window_index}-#{pane_index}.txt' \; display-message 'pane logging toggled -> ~/.tmux-logs/'
# prefix H: dump the full scrollback to a timestamped .txt in ~/.tmux-logs/
bind H run-shell 'mkdir -p ~/.tmux-logs; tmux capture-pane -pS - -t "#{pane_id}" > ~/.tmux-logs/#{session_name}-#{window_index}-#{pane_index}-$(date +%Y%m%d-%H%M%S).txt' \; display-message 'full scrollback saved -> ~/.tmux-logs/'

# --- grab ---------------------------------------------------------------------------
# prefix Tab (extrakto, below): fuzzy-grab a token off screen, copy or inject it.
# custom IP / host:port filters in dot_config/extrakto.

# --- reference ----------------------------------------------------------------------
# prefix ?: browse ~/.config/cheats in glow. runnable commands live in navi (Ctrl-g).
bind ? display-popup -E -w 80% -h 90% "glow ~/.config/cheats 2>/dev/null || ls -1 ~/.config/cheats"

# --- floating popups ----------------------------------------------------------------
bind g display-popup -E -w 90% -h 90% -d "#{pane_current_path}" "lazygit"
bind j display-popup -E -w 90% -h 85% "tmux new-session -A -s scratch"

# --- copy mode + clipboard over SSH (OSC 52) ----------------------------------------
setw -g mode-keys vi
# OSC 52 sends copies to your local clipboard, even over SSH (no xclip needed)
set-option -s set-clipboard on
set -as terminal-features '*:clipboard'
bind P paste-buffer
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi r send-keys -X rectangle-toggle
unbind -T copy-mode-vi Enter
bind-key -T copy-mode-vi Enter send-keys -X copy-selection-and-cancel
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-and-cancel

# --- plugins (TPM) ------------------------------------------------------------------
# TPM vendored by chezmoi; prefix I installs, prefix U updates
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'catppuccin/tmux'
set -g @catppuccin_flavour 'mocha'
# extrakto: osc52 so grabs reach the local clipboard over SSH
set -g @plugin 'laktak/extrakto'
set -g @extrakto_clip_mode 'tmux_osc52'
# Ctrl-f cycle order; ipv4 adds an IP-only mode
set -g @extrakto_filter_order 'word all line ipv4'

# keep this last
run '~/.tmux/plugins/tpm/tpm'
