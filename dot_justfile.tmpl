# Global justfile (justg). Run `justg --list` to see recipes.
# chezmoi and just both use double braces, so recipe args are backtick-escaped to survive apply.

# Re-apply dotfiles and pull the latest external tools
[group('rig')]
update:
    chezmoi apply --refresh-externals

# Every declared tool, where it comes from, and whether it's actually here
[group('rig')]
tools:
    #!/usr/bin/env bash
    set -uo pipefail
    src="$(chezmoi source-path)"
    ok=0; missing=0
    show() {  # $1=binary $2=source label
        if command -v "$1" >/dev/null 2>&1; then
            printf '  \033[32m*\033[0m %-12s %s\n' "$1" "$2"; ok=$((ok+1))
        else
            printf '  \033[31m-\033[0m %-12s %s \033[31m(missing)\033[0m\n' "$1" "$2"; missing=$((missing+1))
        fi
    }

    echo "apt (.chezmoidata/packages.yaml)"
    for p in $(chezmoi data | jq -r '.packages.apt[]'); do
        case "$p" in ca-certificates|git|curl) continue ;; esac   # not binaries you invoke
        b="$p"; [ "$p" = ripgrep ] && b=rg
        show "$b" "apt"
    done

    echo "upstream releases (.chezmoiexternal.toml)"
    for b in $(grep -oE '^\[".local/bin/[^"]+"\]' "$src/.chezmoiexternal.toml" \
               | sed -E 's|.*/([^"]+)".*|\1|'); do
        show "$b" "github release"
    done

    echo "vendor installers (run_once_after_install-linux-tools)"
    for b in just starship; do show "$b" "upstream install.sh"; done

    echo "npm (.chezmoidata/packages.yaml)"
    for b in $(chezmoi data | jq -r '.packages.npm | keys[]'); do show "$b" "npm"; done

    echo
    echo "$ok present, $missing missing. Add a tool: apt/npm in .chezmoidata/packages.yaml,"
    echo "upstream binaries in .chezmoiexternal.toml, system changes in ~/.bootstrap/."

# Scaffold an engagement directory, with a direnv-pinned TARGET
[group('offsec')]
new-project name target="":
    #!/usr/bin/env bash
    set -euo pipefail
    d="{{`{{ name }}`}}"
    mkdir -p "$d"/{recon,loot,exploits,notes,scans,bin}

    # .envrc is the committed shape; .env holds the values and stays out of git
    cat > "$d/.envrc" <<'EOF'
    # direnv loads this on cd. Values live in .env (gitignored); this file is safe to commit.
    dotenv_if_exists .env
    export ENGAGEMENT="$(basename "$PWD")"
    export LOOT="$PWD/loot"
    PATH_add bin
    EOF

    [ -f "$d/.env" ] || printf 'TARGET=%s\n' "{{`{{ target }}`}}" > "$d/.env"
    printf '.env\nloot/\n' > "$d/.gitignore"

    echo "Scaffolded $d/ (recon loot exploits notes scans)"
    if command -v direnv >/dev/null 2>&1; then
        (cd "$d" && direnv allow)
        echo "direnv allowed. cd into $d/ and \$TARGET, \$ENGAGEMENT, \$LOOT are set."
    else
        echo "direnv not installed; $d/.envrc will stay inert until it is."
    fi

# Bail if msfconsole isn't installed
msfcheck := '''
if ! command -v msfconsole &> /dev/null
then
    echo "msfconsole could not be found"
    exit 1
fi
'''

