# Global justfile (~/.justfile). Run `just --list` from anywhere.
# chezmoi templates use Go template syntax; just recipe args use backtick escapes to survive chezmoi apply.

set dotenv-load := false

# ── rig management ───────────────────────────────────────────────────────────

# Apply dotfiles and pull the latest external tool versions
[group('rig')]
update:
    chezmoi apply --refresh-externals

# Every declared tool, where it comes from, whether it's on the box
[group('rig')]
tools:
    #!/usr/bin/env bash
    set -uo pipefail
    ok=0; missing=0
    show() {
        if command -v "$1" >/dev/null 2>&1; then
            printf '  \033[32m*\033[0m %-14s %s\n' "$1" "$2"; ok=$((ok+1))
        else
            printf '  \033[31m-\033[0m %-14s %s \033[31m(missing)\033[0m\n' "$1" "$2"; missing=$((missing+1))
        fi
    }
    echo "── shell & prompt ──────────────────────────────────────────"
    for b in zsh tmux starship atuin navi fzf eza zoxide bat direnv just glow lazygit; do show "$b" "apt / installer"; done
    echo "── offensive tooling ───────────────────────────────────────"
    for b in chisel ligolo-proxy penelope goshs; do show "$b" "~/.local/bin (chezmoiexternal)"; done
    echo "── pentest toolkit ─────────────────────────────────────────"
    for b in nxc netexec hashcat john certipy nuclei subfinder httpx naabu katana dnsx; do show "$b" "apt / go install"; done
    echo "── ai ──────────────────────────────────────────────────────"
    for b in claude codex; do show "$b" "npm (~/.local/bin)"; done
    echo
    echo "$ok present, $missing missing."
    echo "Run 'just update' to pull latest versions."

# ── offsec ───────────────────────────────────────────────────────────────────

# Scaffold an engagement directory with direnv-pinned TARGET/LHOST/LOOT env vars
# Usage: just new-project forest 10.10.11.35
# Or with a path: just new-project htb/labs/forest 10.10.11.35
[group('offsec')]
new-project name target="":
    #!/usr/bin/env bash
    set -euo pipefail
    d="{{ `{{ name }}` }}"
    t="{{ `{{ target }}` }}"
    mkdir -p "$d"/{recon,loot,exploits,notes,scans,bin}

    # .envrc: committed template — safe to version control
    if [ ! -f "$d/.envrc" ]; then
        cat > "$d/.envrc" << 'ENVRC'
    dotenv_if_exists .env
    export ENGAGEMENT="$(basename "$PWD")"
    export LOOT="$PWD/loot"
    PATH_add bin
ENVRC
    fi

    # .env: actual values — gitignored, stays local
    if [ ! -f "$d/.env" ]; then
        LHOST=$(ip -4 -o addr show tun0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1 || echo "10.10.14.x")
        printf 'TARGET=%s\nLHOST=%s\nLPORT=4444\n' "$t" "$LHOST" > "$d/.env"
    fi

    # .gitignore for the engagement
    [ -f "$d/.gitignore" ] || printf '.env\nloot/\n' > "$d/.gitignore"

    # notes.md starting template
    if [ ! -f "$d/notes.md" ]; then
        cat > "$d/notes.md" << NOTES
# $(basename "$d")

- Platform:
- IP: $t
- OS:
- Started: $(date +%Y-%m-%d)

## Hosts

### $t
- **OS:**
- **Ports:**
  | Port | Proto | Service | Version | Notes |
  |------|-------|---------|---------|-------|
  |      |       |         |         |       |
- **Findings:**

## Credentials

| User | Secret (masked) | Source | Works on | Notes |
|------|-----------------|--------|----------|-------|

## Flags

| Flag | Value | Location |
|------|-------|----------|

## Open / to-do
- [ ]
NOTES
    fi

    # targets.txt for navi $ target: picker
    echo "$t" >> "$d/targets.txt"

    echo "Scaffolded $d/"
    if command -v direnv >/dev/null 2>&1; then
        (cd "$d" && direnv allow 2>/dev/null)
        echo "direnv allowed — cd into $d/ and \$TARGET, \$LHOST, \$LOOT are set."
    fi
    echo ""
    echo "Next: cd $d/ && claude  (recon-notes skill takes it from there)"

# ── security utilities ────────────────────────────────────────────────────────

# Print all 256 bad chars as a Python byte string
[group('security')]
badchars:
    #!/usr/bin/env python3
    print('badchars = (')
    for start in range(1, 256, 16):
        row = ''.join(f'\\x{i:02x}' for i in range(start, min(start+16, 256)))
        print(f'    b"{row}"')
    print(')')

# Cyclic De Bruijn pattern (replaces msf-pattern_create)
[group('security')]
pattern length:
    #!/usr/bin/env python3
    import string, sys
    want = int("{{ `{{ length }}` }}")
    pat = "".join(u + l + d for u in string.ascii_uppercase for l in string.ascii_lowercase for d in string.digits)
    if want > len(pat): sys.exit(f"pattern: max length is {len(pat)}")
    print(pat[:want])

# Find offset of crash value in cyclic pattern (replaces msf-pattern_offset)
[group('security')]
offset value:
    #!/usr/bin/env python3
    import string, sys
    raw = "{{ `{{ value }}` }}"
    needle = bytes.fromhex(raw[2:])[::-1].decode("latin-1") if raw.lower().startswith("0x") else raw
    pat = "".join(u + l + d for u in string.ascii_uppercase for l in string.ascii_lowercase for d in string.digits)
    at = pat.find(needle)
    if at < 0: sys.exit(f"offset: {needle!r} not found in pattern")
    print(f"{needle!r} at offset {at}")

# Start MSF multi/handler for meterpreter
# Usage: just handler windows tun0 4444
[group('security')]
handler os iface port:
    #!/usr/bin/env bash
    LHOST=$(ip -4 -o addr show {{ `{{ iface }}` }} 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
    [ -z "$LHOST" ] && { echo "Could not detect IP for {{ `{{ iface }}` }}"; exit 1; }
    if [ "{{ `{{ os }}` }}" = "windows" ]; then
        sudo msfconsole -q -x "use exploit/multi/handler; set payload windows/x64/meterpreter/reverse_tcp; set LHOST $LHOST; set LPORT {{ `{{ port }}` }}; run"
    elif [ "{{ `{{ os }}` }}" = "linux" ]; then
        sudo msfconsole -q -x "use exploit/multi/handler; set payload linux/x64/meterpreter/reverse_tcp; set LHOST $LHOST; set LPORT {{ `{{ port }}` }}; run"
    else
        echo "Usage: just handler <windows|linux> <iface> <port>"
        exit 1
    fi
